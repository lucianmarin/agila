# Pythonic ergonomics in Agila: lambda, enumerate(), zip(), reversed(), f-strings,
# ternary, membership (`in` / `not in`), `//`, `**`, chained comparisons, and multi-line syntax
import Foundation

def main():
    banner: str = """=== Pythonic Agila ===
lambda, enumerate, zip, reversed"""

    # Multi-line nested comprehension
    nums: list[isize] = [
        x * 10 + y
        for x in range(1, 4)
        for y in range(2)
        if x + y > 1
    ]

    # Inline lambda + negative indexing + ternary
    inc: (isize) -> isize = lambda v: isize -> isize: v + 1
    tag: str = "big" if nums[-1] > 20 else "small"

    # Chained comparisons, `not` precedence, `is`, `//`, `**`
    opt: isize? = nil
    ok: bool = 0 < nums[0] < 50 and not 1 == 2 and opt is nil
    fdiv: isize = -7 // 2
    power: isize = 2 ** 3

    # Set/dict membership (`in` / `not in`) + `del`
    seen: set[isize] = {n for n in nums}
    var weights: dict[isize, isize] = {n: inc(n) for n in nums}
    del weights[nums[0]]
    has_20: bool = 20 in seen and 99 not in seen

    print(banner)
    print(f"tag={tag} ok={ok} has_20={has_20} -7//2={fdiv} 2**3={power} mapCount={weights.count}")

    # enumerate(), zip(), and reversed()
    for idx, val in enumerate(nums):
        print(f"  enum[{idx}] = {val}")

    labels: list[str] = ["a", "b", "c", "d", "e"]
    for label, val in zip(labels, nums):
        print(f"  zip({label}, {val})")

    print("  reversed:")
    for r in reversed(nums):
        print(f"    {r}")
